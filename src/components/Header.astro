---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { nav } from '../data/site';
---

<header class="header" id="header">
  <div class="header-inner">
    <a class="logo" href="#home">JK<span class="logo-dot">.</span><span class="visually-hidden"> Justin Kong, back to top</span></a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {nav.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="header-end">
      <Button href="#contact" variant="secondary" size="sm" arrow class="header-cta">Let's Talk</Button>
      <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out),
      backdrop-filter var(--dur-hover) var(--ease-out);
  }

  .header.is-scrolled {
    background: rgba(9, 9, 11, 0.72);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    max-width: var(--content);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
    transition: height 300ms var(--ease-out);
  }

  .is-scrolled .header-inner {
    height: var(--header-h-scrolled);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .logo-dot {
    display: inline-block;
    color: var(--accent);
    transition: transform var(--dur-hover) var(--ease-spring), text-shadow var(--dur-hover) var(--ease-out);
  }

  .logo:hover .logo-dot {
    transform: translateY(-2px);
    text-shadow: 0 0 14px rgba(255, 122, 89, 0.75);
  }

  .nav {
    position: relative;
    display: flex;
    gap: var(--space-6);
    margin-left: auto;
  }

  .nav a {
    padding: 0.4rem 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current='true'] {
    color: var(--text);
  }

  /* One bar for all links: 100px wide, positioned with translateX and sized with scaleX
     (scripts/nav.ts), so moving between links is a single transform transition. */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: translateX(var(--x, 0px)) scaleX(var(--w, 0));
    opacity: var(--o, 0);
    transition:
      transform 420ms var(--ease-out),
      opacity var(--dur-hover) var(--ease-out);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header-end :global(.header-cta) {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .header-end :global(.header-cta:hover) {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border-radius: var(--radius);
  }

  .menu-toggle .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .menu-toggle :global(.icon-close),
  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 860px) {
    .menu-toggle {
      display: grid;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: var(--space-2) var(--gutter) var(--space-5);
      background: rgba(9, 9, 11, 0.96);
      border-bottom: 1px solid var(--border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity var(--dur-hover) var(--ease-out),
        transform var(--dur-hover) var(--ease-out),
        visibility 0s linear var(--dur-hover);
    }

    .nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav a {
      padding: var(--space-3) 0;
      font-size: var(--fs-md);
      border-bottom: 1px solid var(--border);
    }

    .nav a:last-of-type {
      border-bottom: 0;
    }

    .nav-indicator {
      display: none;
    }

    /* The open menu needs a solid bar behind it even at the top of the page. */
    .header:has(.nav.is-open) {
      background: rgba(9, 9, 11, 0.96);
      border-bottom-color: var(--border);
    }
  }

  @media (max-width: 520px) {
    .header-end :global(.header-cta) {
      display: none;
    }
  }
</style>
