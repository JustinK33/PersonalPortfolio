---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import IconSprite from '../components/IconSprite.astro';
import Intro from '../components/Intro.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />

    <title>Justin Kong | Backend &amp; Distributed Systems Engineer</title>
    <meta name="description" content="Justin Kong is a backend and distributed systems engineer building high-performance infrastructure in Go and Python: services over gRPC, event pipelines, and databases tuned for production load. Computer & Data Science at Rutgers." />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Justin Kong | Backend & Distributed Systems Engineer" />
    <meta property="og:description" content="I build high-performance distributed backend and data infrastructure in Go and Python: services over gRPC, event pipelines, and databases tuned for production load." />
    <meta property="og:url" content="https://justinkong.app/" />
    <meta property="og:image" content="https://justinkong.app/static/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://justinkong.app/" />

    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png" />

    <link rel="preload" href="/static/fonts/plexsans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/static/fonts/spacegrotesk.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Runs before first paint. `js` gates every hidden-until-revealed style, so without
         JS all content is simply visible. The intro plays once per session. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          if (!sessionStorage.getItem('jk-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches && !location.hash) {
            root.classList.add('has-intro');
            sessionStorage.setItem('jk-intro', '1');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <IconSprite />
    <Intro />
    <ScrollProgress />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
      import '../scripts/scroll';
      import '../scripts/nav';
      import '../scripts/pointer';
      import '../scripts/copy';
    </script>
  </body>
</html>
